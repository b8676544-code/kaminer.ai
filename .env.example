# העתיקו לקובץ .env ומלאו ערכים. לעולם אל תכניסו כאן ערכים אמיתיים.
# ערכי Supabase המקומי מודפסים ב-`npm run db:start`.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar (OAuth) — צד שרת בלבד
# ב-Google Cloud Console: OAuth Client מסוג Web, ‏Authorized redirect URI:
#   ${NEXT_PUBLIC_SITE_URL}/api/google/oauth/callback  (מקומית: http://localhost:3000/api/google/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# מפתח להצפנת refresh token ב-DB (32 בתים, base64)
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Cron — סוד שבודקים בכל קריאה ל-/api/cron/* (מ-pg_cron). ‏openssl rand -hex 32
CRON_SECRET=

# Integrations (מחקו את מה שלא בשימוש)
# מייל (Resend): התראה על כשלים חוזרים בסנכרון. בלי שניהם: רק פס אזהרה במערכת
# RESEND_API_KEY=
# EMAIL_FROM=kaminer.ai <alerts@your-domain.co.il>

# LAW-6: גיבוי מקומי מוצפן (npm run db:backup). הסיסמה לשמור גם מחוץ למחשב
LOCAL_BACKUP_PASSPHRASE=
# LOCAL_BACKUP_DIR=
